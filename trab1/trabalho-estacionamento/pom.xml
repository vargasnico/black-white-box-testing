<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.edu.testes</groupId>
    <artifactId>estacionamento-tarifa</artifactId>
    <version>1.0</version>
    <name>Calculo de tarifa de estacionamento</name>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <!-- código-fonte testado; o perfil v1 troca pela primeira versão -->
        <codigo.fonte>src/main/java</codigo.fonte>
    </properties>

    <dependencies>
        <!-- inclui junit-jupiter-api, junit-jupiter-params e junit-jupiter-engine -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${codigo.fonte}</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Cobertura de código: mvn test -> target/site/jacoco/index.html -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Teste de mutação: mvn test-compile org.pitest:pitest-maven:mutationCoverage
                 -> target/pit-reports/index.html -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.20.3</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.2</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>estacionamento.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>estacionamento.*</param>
                    </targetTests>
                    <!-- DEFAULTS + remoção de condicionais e outros operadores mais fortes -->
                    <mutators>
                        <mutator>STRONGER</mutator>
                    </mutators>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test        -> executa os testes sobre a versão corrigida (src/main/java)
             mvn test -Pv1   -> executa os mesmos testes sobre a primeira versão (versoes/versao1) -->
        <profile>
            <id>v1</id>
            <properties>
                <codigo.fonte>versoes/versao1</codigo.fonte>
            </properties>
        </profile>
    </profiles>
</project>
